{
  "appId": "io.github.karamegy.twa",
  "appName": "EIDCO Business OS",
  "webDir": "www",
  "server": {
    "url": "https://karamegy.github.io/Nal/auth.html",
    "androidScheme": "https",
    "cleartext": true,
    "allowNavigation": [
      "karamegy.github.io",
      "*.github.io",
      "*.vercel.app",
      "*.firebaseapp.com",
      "*.googleapis.com",
      "*.gstatic.com"
    ]
  },
  "android": {
    "allowMixedContent": true,
    "captureInput": true,
    "backgroundColor": "#020617"
  },
  "plugins": {
    "GoogleAuth": {
      "scopes": [
        "profile",
        "email"
      ],
      "serverClientId": "515898424721-86pclcejrec62gn34st41qdp6rj5j9vt.apps.googleusercontent.com",
      "clientId": "515898424721-ovtpchg5l9ap0r7ik78thic3g8h35kvj.apps.googleusercontent.com",
      "forceCodeForRefreshToken": true
    },
    "SplashScreen": {
      "launchShowDuration": 2000,
      "backgroundColor": "#020617",
      "androidScaleType": "CENTER_CROP",
      "splashFullScreen": true,
      "splashImmersive": true
    }
  }
}
